    "r": 1,
    "w": 1
  },
  "default_channel_node_folder": {
    "foldertype": "node",
    "title": "Каналы Traccar",
    "channels": [
      {
        "chan": "source_snapshot",
        "devpropname": "source_snapshot",
        "title": "Телеметрия Traccar и выбор режима",
        "r": 1,
        "w": 1
      }
    ]
  }
}
