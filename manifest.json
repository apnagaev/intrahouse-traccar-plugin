{
  "name": "traccar",
  "description": "Телеметрия трекеров из Traccar",
  "module": "index.js",
  "single": 0,
  "nochannels": 0,
  "spawn": 0,
  "channel_popup": {
    "add": [
      {
        "id": "channel_node_folder",
        "title": "Набор каналов Traccar"
      },
      {
        "id": "channel",
        "title": "$NewChannel"
      }
